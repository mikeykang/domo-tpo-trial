<html>
<head>
    <title>공지사항</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="robots" content="noindex" />
    <style type="text/css">
        img { border:none; }
        #msg { position:fixed; display:table-cell;  text-align:center; background-color:#ffffff; width:510px; height:550px; left:50%; top:50%; margin:-250px 0 0 -250px; font-family:'맑은 고딕','Malgun Gothic', sans-serif; border-bottom:1px solid #eaeaea;}
        #msg {
            -webkit-box-shadow: 0px 0px 44px 0px rgba(0,0,0,0.54);
            -moz-box-shadow: 0px 0px 44px 0px rgba(0,0,0,0.54);
            box-shadow: 0px 0px 44px 0px rgba(0,0,0,0.54);
        }
        #msg .visual { padding:70px 0 0; }
        #msg h2 { margin:19px 0 20px; padding:0; font-size:34px; font-weight:normal; letter-spacing:-1px; word-spacing:-4px; text-align:center; color:#1b87d4; }
        #msg .detail { border-top:1px solid #eaeaea; font-size:18px; line-height:1.4em; letter-spacing:-0.05em; }
    </style>
</head>

<!--<body style="margin:0; padding:0; background:url('//img.cafe24.com/images/ec_hosting/server/bg_echosting.jpg') 50% 0;background-repeat:no-repeat;">-->

<div id="msg">
    <div class="visual"><img src="https://img.echosting.cafe24.com/suio/state/img_hourglass.gif" alt=""></div>
    <h2>
        <script>
            var userLang = navigator.language || navigator.userLanguage;
            var message;

            switch (userLang) {
                case 'ko':
                case 'ko-KR':
                    message = '서버 점검 작업 안내';
                    break;
                case 'en':
                case 'en-US':
                    message = 'Server Maintenance Notice';
                    break;
                case 'zh':
                case 'zh-CN':
                case 'zh-TW':
                    message = '服务器维护通知';
                    break;
                case 'ja':
                case 'ja-JP':
                    message = 'サーバーメンテナンスのお知らせ';
                    break;
                default:
                    message = 'Server Maintenance Notice';
            }

            document.write(message);
        </script>
    </h2>
    <div class="detail">
        <div class="content">
            <!-- [공지 메세지를 작성 하세요] -->
            <p>
                <script>
                    var userLang = navigator.language || navigator.userLanguage;
                    var maintenanceMessage;

                    switch (userLang) {
                        case 'ko':
                        case 'ko-KR':
                            maintenanceMessage = '보다 원활한 서비스 제공을 위한 서버 점검 중입니다. <br>점검 시간 이후에 재접속 부탁드립니다.<br>이용에 불편을 드려서 죄송합니다.';
                            break;
                        case 'en':
                        case 'en-US':
                            maintenanceMessage = 'We are currently conducting server maintenance to<br>provide a smoother service. <br>Please reconnect after the maintenance period. <br>We apologize for any inconvenience.';
                            break;
                        case 'zh':
                        case 'zh-CN':
                        case 'zh-TW':
                            maintenanceMessage = '我们目前正在进行服务器维护，以提供更顺畅的服务。 <br>请在维护期后重新连接。 <br>对此造成的不便，我们深感抱歉。';
                            break;
                        case 'ja':
                        case 'ja-JP':
                            maintenanceMessage = 'よりスムーズなサービスを提供するため、<br> 現在サーバーメンテナンスを実施しています。<br>メンテナンス期間後に再接続してください。 <br>ご不便をおかけして申し訳ありません。';
                            break;
                        default:
                            maintenanceMessage = 'We are currently conducting server maintenance to provide a smoother service. <br>Please reconnect after the maintenance period. <br>We apologize for any inconvenience.';
                    }

                    document.write(maintenanceMessage);
                </script>
            </p>
            <p>
                <strong>
                    <script>
                        var userLang = navigator.language || navigator.userLanguage;
                        var maintenanceTimeMessage;

                        switch (userLang) {
                            case 'ko':
                            case 'ko-KR':
                                maintenanceTimeMessage = '서버 점검 시간 : 02시 22분 ~ 02시 52분';
                                break;
                            case 'en':
                            case 'en-US':
                                maintenanceTimeMessage = 'Server Maintenance Time: 02:22 ~ 02:52 (KST/UTC+9)';
                                break;
                            case 'zh':
                            case 'zh-CN':
                            case 'zh-TW':
                                maintenanceTimeMessage = '服务器维护时间：02时22分至02时52分 (KST/UTC+9)';
                                break;
                            case 'ja':
                            case 'ja-JP':
                                maintenanceTimeMessage = 'サーバーメンテナンス時間：02時22分〜02時52分 (KST/UTC+9)';
                                break;
                            default:
                                maintenanceTimeMessage = 'Server Maintenance Time: 02:22 ~ 02:52 (KST/UTC+9)';
                        }

                        document.write(maintenanceTimeMessage);
                    </script>
                </strong>
            </p>
        </div>
    </div>
</div>

</body>
</html>